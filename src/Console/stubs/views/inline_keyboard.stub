<?php

/*
 * Inline keyboard. The 2nd argument of button() is the callback data your routes
 * match on — keep it stable and in one language, and translate only the visible
 * label, e.g. button(__('laragram.menu.button'), 'action').
 *
 * Other helpers: href(), web_app(), login_url(), switch_inline(), copy_text(),
 * pay(), callback_game(). Each takes optional trailing style:/icon: arguments.
 *
 * Buttons may sit behind conditions: if none is added, the message is simply sent
 * without a keyboard.
 */

button('Button', 'action');
row();
href('Open site', 'https://example.com');
