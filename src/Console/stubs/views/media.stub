<?php

/*
 * Media group (sendMediaGroup). Minimum 2 items, maximum 10.
 *
 * Each item takes a file_id or an https:// URL. Pass real values in from the
 * controller — view('album', ['cover_id' => $a, 'clip_id' => $b]) — and use them
 * here as $cover_id / $clip_id.
 *
 * Captions are escaped for you. For a multilingual bot, translate them with
 * __('laragram.<key>'); the locale is already set per user.
 */

photo('https://example.com/cover.jpg', caption: 'First item');
video('https://example.com/clip.mp4');
