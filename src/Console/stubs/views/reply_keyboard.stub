<?php

/*
 * Reply keyboard. Unlike an inline button, a reply button sends its LABEL back as
 * the message text — so if you translate the labels with __(), the route has to
 * match the same translation, e.g. ->contains(__('laragram.menu.option_a')).
 *
 * Buttons may sit behind conditions: if none is added, the message is simply sent
 * without a keyboard — which leaves the one already on screen in place. Call
 * remove_keyboard() in the else branch to clear it.
 *
 * Cannot coexist with inline_keyboard.php in the same view.
 */

resize();

reply('Option A');
reply('Option B');
